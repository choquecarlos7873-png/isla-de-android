<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="32dp">
        <ImageView android:layout_width="144dp" android:layout_height="144dp" android:src="@drawable/ic_island" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/eyebrow" android:textColor="#087F73" android:textSize="12sp" android:letterSpacing="0.15"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/welcome" android:textSize="36sp" android:textStyle="bold" android:textColor="#163B35" android:gravity="center"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/description" android:textSize="18sp" android:textColor="#536B65" android:gravity="center"/>
        <Button android:id="@+id/start_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="32dp" android:text="@string/start" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#087F73"/>
    </LinearLayout>
</ScrollView>
